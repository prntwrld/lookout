  {"id":56262,"slug":"arcyria-denudata","sci":"Arcyria denudata","common":"carnival candy slime mold","family":"Arcyriaceae","obs":126,"regions":["north-cascades","south-cascades","olympics","oregon-cascades"],"months":[5,6,7,9,10,11,12],"photos":[{"id":4163032,"ext":"JPG","by":"Fluff Berger","lic":"CC BY-SA"},{"id":24732,"ext":"jpg","by":"kim fleming","lic":"CC BY-NC-SA"},{"id":12002644,"ext":"jpg","by":"Alexander Shirokikh","lic":"CC BY-NC"},{"id":417648552,"ext":"jpg","by":"Cho Fungi","lic":"CC BY-NC"},{"id":2960579,"ext":"jpg","by":"Damon Tighe","lic":"CC BY-NC"}],"wiki":"Arcyria denudata","summary":"Arcyria denudata, commonly known as carnival candy slime mold, is a species of myxomycete slime mold in the family Arcyriaceae. It is one of the most common species of slime molds, and can be found in temperate environments worldwide."},
