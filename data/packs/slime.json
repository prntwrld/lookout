"species":[
  {"id":55483,"slug":"fuligo-septica","sci":"Fuligo septica","common":"Dog Vomit Slime Mold","family":"Physaraceae","obs":5525,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[5,6,7,8,9],"photos":[{"id":33421817,"ext":"jpg","by":"Dougal Townsend","lic":"CC BY-NC"},{"id":155330436,"ext":"jpg","by":"misskittys","lic":"CC BY-NC"},{"id":154610185,"ext":"jpg","by":"sdmiliotis","lic":"CC BY-NC"},{"id":10722,"ext":"jpg","by":"AnneTanne","lic":"CC BY-NC"},{"id":33421809,"ext":"jpg","by":"Dougal Townsend","lic":"CC BY-NC"}],"wiki":"Fuligo septica","summary":"Fuligo septica is a species of plasmodial slime mold, and a member of the Myxomycetes class. It is commonly known as the scrambled egg slime, or flowers of tan because of its peculiar yellowish, bile-colored appearance. Also known as the dog vomit slime mold, it is common with a worldwide distribution, and it is often found on bark mulch in urban areas after heavy rain or excessive watering."},
  {"id":56252,"slug":"ceratiomyxa-fruticulosa","sci":"Ceratiomyxa fruticulosa","common":"Common Coral Slime","family":"Ceratiomyxaceae","obs":2747,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[4,5,6,7,8,9,10],"photos":[{"id":342355226,"ext":"jpg","by":"Alan Rockefeller","lic":"CC BY"},{"id":162972338,"ext":"jpeg","by":"an iNaturalist observer","lic":"CC0"},{"id":11060,"ext":"jpg","by":"kim fleming","lic":"CC BY-NC-SA"},{"id":239665195,"ext":"jpg","by":"Kit Law","lic":"CC BY-NC"},{"id":78054716,"ext":"jpg","by":"hilbert","lic":"CC BY-NC"}],"wiki":"Ceratiomyxa fruticulosa","summary":"Ceratiomyxa is a genus of plasmodial slime mould within the Eumycetozoa, first described by Pier Antonio Micheli. They are widely distributed and commonly found on decaying wood."},
  {"id":56273,"slug":"leocarpus-fragilis","sci":"Leocarpus fragilis","common":"insect-egg slime","family":"Physaraceae","obs":691,"regions":["central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[1,2,5,6,7,8,10,11,12],"photos":[{"id":251110640,"ext":"jpg","by":"Alan Rockefeller","lic":"CC BY"},{"id":28677538,"ext":"jpeg","by":"Sarka Martinez","lic":"CC BY-NC-SA"},{"id":334283768,"ext":"jpeg","by":"Tyson Ehlers","lic":"CC BY-NC"},{"id":24736,"ext":"jpg","by":"Jason Hollinger","lic":"CC BY-SA"},{"id":2409672,"ext":"JPG","by":"Jakob Fahr","lic":"CC BY-NC"}],"wiki":"Leocarpus fragilis","summary":"Leocarpus fragilis is a myxogastrid or acellular slime mold of the genus Leocarpus. The common name in English is insect-egg slime mold. L.fragilis can be found on leaf litter, typically in temperate and boreal forests where the ground litter is acidic. It has been found on all continents except Antarctica but is most commonly found in the northern hemisphere."},
  {"id":145366,"slug":"reticularia-lycoperdon","sci":"Reticularia lycoperdon","common":"False Puffball","family":"Reticulariaceae","obs":479,"regions":["north-cascades","central-cascades","south-cascades","gorge","olympics","oregon-cascades"],"months":[4,5,6,7,8,9],"photos":[{"id":10326791,"ext":"jpeg","by":"Damon Tighe","lic":"CC BY-NC"},{"id":32381313,"ext":"jpeg","by":"babette Dillon","lic":"CC BY-NC"},{"id":17241697,"ext":"jpg","by":"an iNaturalist observer","lic":"CC0"},{"id":317420,"ext":"JPG","by":"Rob Curtis","lic":"CC BY-NC-SA"},{"id":466157418,"ext":"jpg","by":"Jan Thornhill","lic":"CC BY-NC"}],"wiki":"Reticularia lycoperdon","summary":"Enteridium lycoperdon, the false puffball, is one of the more obvious species of slime mould or Myxogastria, typically seen in its reproductive phase as a white 'swelling' on standing dead trees in the spring, or on large pieces of fallen wood. Alder (Alnus glutinosa) is a common host."},
  {"id":56264,"slug":"badhamia-utricularis","sci":"Badhamia utricularis","common":"","family":"Physaraceae","obs":431,"regions":["north-cascades","central-cascades","gorge","olympics","oregon-cascades"],"months":[1,2,3,10,11,12],"photos":[{"id":248030390,"ext":"jpeg","by":"Tyson Ehlers","lic":"CC BY-NC"},{"id":177043142,"ext":"jpeg","by":"jfb22","lic":"CC BY-NC"},{"id":248030380,"ext":"jpeg","by":"Tyson Ehlers","lic":"CC BY-NC"},{"id":30524560,"ext":"jpg","by":"Damon Tighe","lic":"CC BY-NC"},{"id":110630932,"ext":"jpg","by":"hazelcashman","lic":"CC BY-NC"}],"wiki":"Badhamia utricularis","summary":"Badhamia utricularis is a species of slime mold in the family Physaraceae. It was originally described as Sphaerocarpus utricularis Bull. in 1789."},
  {"id":1556412,"slug":"ceratiomyxa-porioides","sci":"Ceratiomyxa porioides","common":"Honeycomb Coral Slime Mold","family":"Ceratiomyxaceae","obs":305,"regions":["north-cascades","central-cascades","south-cascades","olympics","oregon-cascades"],"months":[5,6,7,8,9,10],"photos":[{"id":305803470,"ext":"jpg","by":"Robert Roach","lic":"CC BY"},{"id":393454714,"ext":"jpg","by":"Alison Pollack","lic":"CC BY-NC"},{"id":394090237,"ext":"jpeg","by":"Igor Khomenko","lic":"CC BY-NC"},{"id":177160670,"ext":"jpeg","by":"Vladimir Bryukhov","lic":"CC BY-NC"},{"id":178583259,"ext":"jpeg","by":"Vladimir Bryukhov","lic":"CC BY-NC"}],"wiki":"Ceratiomyxa porioides","summary":"Ceratiomyxa porioides, also known as the honeycomb coral slime mold, is a common species of slime mold in the Mycetozoa group. Long considered a morphological variant of Ceratiomyxa fruticulosa, C. poriodes was described as a separate species in 2024 based on transcriptomes. C. fruticulosa has historically been considered a widespread cosmopolitan species."},
  {"id":1441996,"slug":"hemitrichia-decipiens","sci":"Hemitrichia decipiens","common":"salmon-eggs","family":"Hemitrichiaceae","obs":299,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[9,10,11,12],"photos":[{"id":240070416,"ext":"jpg","by":"Alexis Tinker-Tsavalas","lic":"CC BY"},{"id":179308351,"ext":"jpg","by":"Marcin Klisz","lic":"CC BY-NC"},{"id":612505255,"ext":"jpg","by":"Tyson Ehlers","lic":"CC BY-NC"},{"id":2429706,"ext":"jpg","by":"Kari Pihlaviita","lic":"CC BY-NC"},{"id":610504270,"ext":"jpg","by":"an iNaturalist observer","lic":"CC0"}],"wiki":"","summary":""},
  {"id":1504198,"slug":"didymium-spongiosum","sci":"Didymium spongiosum","common":"Dog Sick Slime Mould","family":"Didymiaceae","obs":284,"regions":["north-cascades","central-cascades","south-cascades","olympics","oregon-cascades"],"months":[3,4,5,6,7,8,10,11],"photos":[{"id":111545252,"ext":"jpg","by":"Josué Amoroso","lic":"CC BY-NC"},{"id":18357,"ext":"jpg","by":"scorzonera","lic":"CC BY-NC"},{"id":18355,"ext":"jpg","by":"tomasz przechlewski","lic":"CC BY"},{"id":18351,"ext":"jpg","by":"AnneTanne","lic":"CC BY-NC"},{"id":18356,"ext":"jpg","by":"AnneTanne","lic":"CC BY-NC-SA"}],"wiki":"Didymium spongiosum","summary":"Didymium spongiosum, also known as dog sick slime mold, is a species of true slime mold in the order Physarales. Before reclassification in 2023 it was known as Mucilago crustacea. Due to its visual resemblance to canine vomit, it is known colloquially as the \"dog sick slime mould\" or \"dog sick fungus\", albeit that slime moulds are not true fungi."},
