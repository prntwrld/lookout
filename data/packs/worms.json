  {"id":47737,"slug":"harpaphe-haydeniana","sci":"Harpaphe haydeniana","common":"Yellow-spotted Millipede","family":"Xystodesmidae","obs":13491,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[4,5,6,7,8,9],"photos":[{"id":10498,"ext":"jpg","by":"Franco Folini","lic":"CC BY"},{"id":133450745,"ext":"jpeg","by":"Rand Workman","lic":"CC BY-SA"},{"id":330576,"ext":"JPG","by":"101595408250610106310","lic":"CC BY"},{"id":275407,"ext":"jpg","by":"Sam McNally","lic":"CC BY-NC"},{"id":290319,"ext":"jpg","by":"Liam O'Brien","lic":"CC BY-NC"}],"wiki":"Harpaphe haydeniana","summary":"Harpaphe haydeniana is a species of polydesmidan millipede found in the moist forests along the Pacific coast of North America, from Southeast Alaska to California. The dark coloration with contrasting yellow-tipped keels warn of its ability to exude toxic hydrogen cyanide as a defense."},
