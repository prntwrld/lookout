  {"id":336972,"slug":"cylindroiulus-punctatus","sci":"Cylindroiulus punctatus","common":"Blunt-tailed Snake Millipede","family":"Julidae","obs":81,"regions":[],"months":[3,4,5,9,10,11],"photos":[{"id":376166998,"ext":"jpeg","by":"Alexis Tinker-Tsavalas","lic":"CC BY"},{"id":185484570,"ext":"jpeg","by":"Marie Lou Legrand","lic":"CC BY-NC"},{"id":115817594,"ext":"jpg","by":"Gilles San Martin","lic":"CC BY-SA"},{"id":2055393,"ext":"JPG","by":"Jakob Fahr","lic":"CC BY-NC"},{"id":466558235,"ext":"jpg","by":"Joss Carr","lic":"CC BY"}],"wiki":"Cylindroiulus punctatus","summary":"Cylindroiulus punctatus (also known as the blunt-tailed snake millipede) is a species of millipede in the Julidae family. It was described by Leach in 1815 and can be found in western Europe, including Great Britain. It has been introduced in North America...."},
  {"id":133831,"slug":"blaniulus-guttulatus","sci":"Blaniulus guttulatus","common":"Spotted Snake Millipede","family":"Blaniulidae","obs":78,"regions":[],"months":[1,2,3,4,5,6,9,10,11],"photos":[{"id":246883108,"ext":"jpeg","by":"Saryu Mae 前 朝琉","lic":"CC BY"},{"id":576443544,"ext":"jpg","by":"Joeb","lic":"CC BY"},{"id":393960040,"ext":"jpg","by":"Frank Ashwood","lic":"CC BY"},{"id":34923571,"ext":"jpg","by":"Owen Strickland","lic":"CC BY"},{"id":26269195,"ext":"jpeg","by":"Alex Bairstow","lic":"CC BY-NC"}],"wiki":"Blaniulus guttulatus","summary":"Blaniulus guttulatus, commonly known as the spotted snake millipede is a species of millipede in the family Blaniulidae that can be found in Central and Western Europe (except for Portugal). It has been introduced in North American countries such as the United States, Canada, Saint Helena, and Tristan da Cunha, as well as Tasmania and Norfolk Island, Australia."},
