  {"id":543421,"slug":"thrinaphe-hargeri","sci":"Thrinaphe hargeri","common":"","family":"Xystodesmidae","obs":194,"regions":["south-cascades","gorge","oregon-cascades"],"months":[3,4,5],"photos":[{"id":339915306,"ext":"jpg","by":"Andrea Wuenschel","lic":"CC BY-NC"},{"id":360858886,"ext":"jpeg","by":"wetlandwanderer","lic":"CC BY-NC"},{"id":251789118,"ext":"jpeg","by":"wetlandwanderer","lic":"CC BY-NC"},{"id":81680532,"ext":"jpg","by":"abreinin","lic":"CC BY-NC"},{"id":488590630,"ext":"jpg","by":"sofiaayala","lic":"CC BY-NC"},{"id":489089661,"ext":"jpg","by":"Will Richter","lic":"CC BY-NC"}],"wiki":"Thrinaphe","summary":"Thrinaphe is a genus of millipede in the family Xystodesmidae with a single described species. The genus was erected by Rowland M. Shelley in 1993 based on samples collected by Dr. Shelley in 1991 as well as museum type specimens collected by K. Goeden in 1968. The genus is found in the Cascade mountains on the Washington/Oregon border as well as down into the Willamette Valley."},
