  {"id":122163,"slug":"arctonoe-vittata","sci":"Arctonoe vittata","common":"Red-banded Commensal Scaleworm","family":"Polynoidae","obs":154,"regions":["olympics"],"months":[1,2,4,5,6,7,8,11,12],"photos":[{"id":2020343,"ext":"jpg","by":"Robin Gwen Agarwal","lic":"CC BY-NC"},{"id":2099869,"ext":"JPG","by":"Robin Gwen Agarwal","lic":"CC BY-NC"},{"id":2016052,"ext":"jpg","by":"Donna Pomeroy","lic":"CC BY-NC"},{"id":9227707,"ext":"jpg","by":"Wendy Feltham","lic":"CC BY-NC"},{"id":7567521,"ext":"jpeg","by":"Erin McKittrick","lic":"CC BY"}],"wiki":"Arctonoe vittata","summary":"Arctonoe vittata is a species of scaled polychaete worms commonly known as a \"scale worm\". This species often lives as a commensal of another marine animal."},
  {"id":127409,"slug":"eisenia-fetida","sci":"Eisenia fetida","common":"Redworm","family":"Lumbricidae","obs":146,"regions":["central-cascades"],"months":[1,2,3,4,5,9,10,11,12],"photos":[{"id":1273764,"ext":"","by":"Steve Kerr","lic":"CC BY"},{"id":472711698,"ext":"png","by":"Jonas V.","lic":"CC BY"},{"id":472711727,"ext":"png","by":"Jonas V.","lic":"CC BY"},{"id":1273765,"ext":"","by":"Steve Kerr","lic":"CC BY"},{"id":223774,"ext":"jpg","by":"J. Maughn","lic":"CC BY-NC"}],"wiki":"Eisenia fetida","summary":"Eisenia fetida (older spelling: foetida), known under various common names such as redworm, brandling worm, panfish worm, trout worm, tiger worm, red wiggler worm, red californian earth worm, etc., is a species of earthworm adapted to decaying organic material. These worms thrive in rotting vegetation, compost, and manure. They are epigean, rarely found in soil. In this trait they resemble Lumbricus rubellus."},
  {"id":424912,"slug":"octoglena-anura","sci":"Octoglena anura","common":"","family":"Hirudisomatidae","obs":124,"regions":["north-cascades","central-cascades","south-cascades","oregon-cascades"],"months":[1,2,3,4,5,6,10,11,12],"photos":[{"id":108469480,"ext":"jpg","by":"corndog","lic":"CC BY-NC"},{"id":180229946,"ext":"jpeg","by":"jamie axall","lic":"CC BY-NC"},{"id":617319267,"ext":"jpg","by":"an iNaturalist observer","lic":"CC0"},{"id":459729117,"ext":"jpeg","by":"Toby","lic":"CC BY-NC"},{"id":761467209,"ext":"jpg","by":"Justin Altemus","lic":"CC BY-NC"},{"id":268937263,"ext":"jpg","by":"Casey H. Richart","lic":"CC BY"}],"wiki":"Octoglena anura","summary":"Octoglena anura is a species of millipede in the family Hirudisomatidae. It is found in North America."},
  {"id":199376,"slug":"lumbricus-rubellus","sci":"Lumbricus rubellus","common":"Redhead Worm","family":"Lumbricidae","obs":120,"regions":["north-cascades"],"months":[1,2,3,4,5,6,10],"photos":[{"id":587915416,"ext":"jpg","by":"Sawyer Hess","lic":"CC BY"},{"id":167842198,"ext":"jpg","by":"Марина Горбунова-Ëлкина","lic":"CC BY-NC"},{"id":111285273,"ext":"jpg","by":"Gracie Catanzaro","lic":"CC BY-NC"},{"id":466549593,"ext":"jpg","by":"Blaise Verrier-Cruz","lic":"CC BY-NC"},{"id":167842173,"ext":"jpg","by":"Марина Горбунова-Ëлкина","lic":"CC BY-NC"}],"wiki":"Lumbricus rubellus","summary":"Lumbricus rubellus is a species of earthworm that is related to Lumbricus terrestris. It is usually reddish brown or reddish violet, iridescent dorsally, and pale yellow ventrally. They are usually about 25 millimetres to 105 millimetres in length, with around 95–120 segments. Their native distribution was mainland Europe and the British Isles, but they have currently spread worldwide in suitable habitats."},
  {"id":358274,"slug":"octolasion-cyaneum","sci":"Octolasion cyaneum","common":"Blue-grey Worm","family":"Lumbricidae","obs":120,"regions":["north-cascades","gorge","olympics"],"months":[1,2,3,4,11,12],"photos":[{"id":280816544,"ext":"jpg","by":"Philip Griffin","lic":"CC BY-NC"},{"id":365655651,"ext":"jpg","by":"Chris G Earley","lic":"CC BY-NC"},{"id":106773836,"ext":"jpg","by":"Jon Mortin","lic":"CC BY"},{"id":8207333,"ext":"jpg","by":"Steve Kerr","lic":"CC BY"},{"id":70476188,"ext":"jpg","by":"Sally Anderson","lic":"CC BY-NC"}],"wiki":"Octolasion cyaneum","summary":"Octolasion cyaneum, known commonly as the blue-grey earthworm or steel-blue worm, is a species of earthworm in the genus Octolasion. It is one of the most widespread lumbricids, and can be found on every continent."},
