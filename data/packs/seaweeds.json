  {"id":182892,"slug":"desmarestia-viridis","sci":"Desmarestia viridis","common":"stringy acid kelp","family":"Desmarestiaceae","obs":210,"regions":[],"months":[3,4,5],"photos":[{"id":956787,"ext":"jpeg","by":"Ingrid P. Lin","lic":"CC BY-NC-SA"},{"id":956789,"ext":"jpg","by":"Biodiversity Heritage Library","lic":"CC BY"},{"id":828520,"ext":"JPG","by":"tdwyer00","lic":"CC BY-NC"},{"id":878711,"ext":"jpg","by":"Wendy Feltham","lic":"CC BY-NC"}],"wiki":"Desmarestia viridis","summary":"Desmarestia viridis is a species of brown algae found worldwide. Its common names include stringy acid kelp, green acid kelp, Desmarest's green weed, and sea sorrel, though the last name can refer to other species of Desmarestia. The light brown thallus is delicate with a disc-shaped holdfast. It releases sulfuric acid when damaged, destroying itself and nearby seaweeds in the process."},
  {"id":182932,"slug":"scytosiphon-lomentaria","sci":"Scytosiphon lomentaria","common":"Beanweed","family":"Scytosiphonaceae","obs":194,"regions":[],"months":[3,4,5],"photos":[{"id":172064108,"ext":"jpg","by":"Frédéric ANDRE","lic":"CC BY-NC"},{"id":376795785,"ext":"jpeg","by":"wilfredj","lic":"CC BY-NC"},{"id":51013178,"ext":"jpeg","by":"Jacqui Geux","lic":"CC BY"},{"id":172064287,"ext":"jpeg","by":"Frédéric ANDRE","lic":"CC BY-NC"},{"id":58121583,"ext":"jpeg","by":"Richard Taylor","lic":"CC BY-NC"}],"wiki":"Scytosiphon lomentaria","summary":"Scytosiphon lomentaria is a littoral brown seaweed with an irregularly lobed many filamentous form. It is a member of the Phaeophyta in the order Dictyosiphonales and grows attached to shells and stones in rock-pools and in near-shore waters. The attachment to the substrate is by a small disc shaped holdfast."},
  {"id":345459,"slug":"desmarestia-herbacea","sci":"Desmarestia herbacea","common":"","family":"Desmarestiaceae","obs":192,"regions":["olympics"],"months":[3,4,5,6,7,8],"photos":[{"id":7539190,"ext":"jpg","by":"Liam O'Brien","lic":"CC BY-NC"},{"id":253935137,"ext":"jpg","by":"Bridgette Clarkston","lic":"CC BY-SA"},{"id":218395544,"ext":"jpg","by":"ellakerr","lic":"CC BY-NC"},{"id":253935146,"ext":"jpg","by":"Bridgette Clarkston","lic":"CC BY-SA"},{"id":383725406,"ext":"jpg","by":"Bridgette Clarkston","lic":"CC BY-NC"}],"wiki":"Desmarestia herbacea","summary":"Desmarestia herbacea is a species of brown algae found worldwide. Its common names include color changer, Desmarest's flattened weed, and sea sorrel, though the last name can also refer to other species of Desmarestia."},
  {"id":124209,"slug":"laminaria-sinclairii","sci":"Laminaria sinclairii","common":"dense-clumped kelp","family":"Laminariaceae","obs":189,"regions":["olympics"],"months":[3,4,5,6,7,8],"photos":[{"id":4215484,"ext":"JPG","by":"Rebecca Johnson","lic":"CC BY-NC"},{"id":41475931,"ext":"jpeg","by":"Alison Young","lic":"CC BY-NC"},{"id":13266327,"ext":"jpg","by":"an iNaturalist observer","lic":"CC0"},{"id":5355044,"ext":"jpg","by":"minustide","lic":"CC BY-NC-SA"}],"wiki":"Laminaria sinclairii","summary":"Laminaria sinclairii is a species of brown algae (class Phaeophyceae), in the family Laminariaceae. It is native to the lower intertidal zone of the northeastern Pacific Ocean from British Columbia southwards to California."},
