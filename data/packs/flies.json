  {"id":81979,"slug":"syritta-pipiens","sci":"Syritta pipiens","common":"Thick-legged Hover Fly","family":"Syrphidae","obs":2365,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[5,6,7,8,9],"photos":[{"id":368022,"ext":"jpg","by":"Marcello Consolo","lic":"CC BY-NC-SA"},{"id":640754,"ext":"jpg","by":"Marcello Consolo","lic":"CC BY-NC-SA"},{"id":1109567,"ext":"jpg","by":"Marcello Consolo","lic":"CC BY-NC-SA"},{"id":368020,"ext":"jpg","by":"Marcello Consolo","lic":"CC BY-NC-SA"},{"id":1155383,"ext":"jpg","by":"Marcello Consolo","lic":"CC BY-NC-SA"}],"wiki":"Syritta pipiens","summary":"Syritta pipiens is a common species of European hover fly. It is sometimes called the thick-legged hoverfly, from its distinctive broad hind femora. They are fast nimble fliers, and the larvae feed in rotting organic matter."},
  {"id":70211,"slug":"myathropa-florea","sci":"Myathropa florea","common":"Yellow-haired Sun Fly","family":"Syrphidae","obs":2138,"regions":["central-cascades","gorge","olympics","oregon-cascades"],"months":[4,5,6,7,8,9],"photos":[{"id":90897960,"ext":"jpeg","by":"Michael Knapp","lic":"CC BY"},{"id":17267491,"ext":"jpeg","by":"Kostas Zontanos","lic":"CC BY"},{"id":32323111,"ext":"jpeg","by":"daniele birtele","lic":"CC BY-NC"},{"id":683803945,"ext":"jpg","by":"Conquest","lic":"CC BY"},{"id":90230546,"ext":"jpeg","by":"Michael Knapp","lic":"CC BY"}],"wiki":"Myathropa florea","summary":"Myathropa florea is a very common European and North African species of hoverfly. Adults may be seen on flowers from May to September. It is of similar size as the drone fly, but living Myathropa are generally more yellow, with two light bands to the thorax, interrupted with a black central smudge. In museum specimens, any yellow colour soon fades to brown after death."},
