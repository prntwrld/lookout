  {"id":225815,"slug":"neriene-radiata","sci":"Neriene radiata","common":"Filmy Dome Spider","family":"Linyphiidae","obs":440,"regions":["north-cascades","central-cascades","rainier","south-cascades","gorge","olympics","oregon-cascades"],"months":[4,5,6,7,8],"photos":[{"id":4692788,"ext":"jpg","by":"anhe","lic":"CC BY-NC"},{"id":9249783,"ext":"jpg","by":"Matt Claghorn","lic":"CC BY-NC"},{"id":8664503,"ext":"jpg","by":"Ryan Hodnett","lic":"CC BY-SA"},{"id":481001015,"ext":"jpg","by":"Michael Stein","lic":"CC BY-NC"},{"id":692317710,"ext":"jpg","by":"ell","lic":"CC BY-NC"},{"id":75458128,"ext":"jpeg","by":"Kate McKeown","lic":"CC BY-NC"}],"wiki":"Filmy dome spider","summary":"The filmy dome spider (Neriene radiata) is a sheet weaver: a spider in the family Linyphiidae with a holarctic distribution. These spiders construct a dome of fine silk and hang upside-down under it, waiting for their prey."},
  {"id":123713,"slug":"neoscona-oaxacensis","sci":"Neoscona oaxacensis","common":"Western Spotted Orbweaver","family":"Araneidae","obs":434,"regions":["central-cascades","gorge"],"months":[7,8,9],"photos":[{"id":1309300,"ext":"jpg","by":"Michael Schmidt","lic":"CC BY-NC-SA"},{"id":2480431,"ext":"JPG","by":"SHadoly Green Gray","lic":"CC BY-NC"},{"id":43825777,"ext":"jpeg","by":"cryschellejeffery","lic":"CC BY-NC"},{"id":4985999,"ext":"jpg","by":"lazarus","lic":"CC BY"},{"id":27961479,"ext":"jpg","by":"Melanie","lic":"CC BY-NC"}],"wiki":"Neoscona oaxacensis","summary":"Neoscona oaxacensis, known as western spotted orbweaver and zig-zag spider, is a species of spider in the family Araneidae. It is distributed in the Americas, being widespread across Western USA and Mexico and Central America to at least Costa Rica, with sporadic southern reports from Colombia, Venezuela, Ecuador and Peru, including the Galápagos Islands."},
  {"id":60599,"slug":"ixodes-pacificus","sci":"Ixodes pacificus","common":"Western Black-legged Tick","family":"Ixodidae","obs":421,"regions":["north-cascades","central-cascades","rainier","gorge","olympics","oregon-cascades"],"months":[1,2,3,4,5,6,11],"photos":[{"id":592905,"ext":"jpg","by":"an iNaturalist observer","lic":"CC0"},{"id":249888803,"ext":"jpeg","by":"Martin Galli","lic":"CC BY-NC"},{"id":7167874,"ext":"jpeg","by":"Darin J McGuire","lic":"CC BY"},{"id":176838322,"ext":"jpg","by":"samaki","lic":"CC BY-NC"},{"id":176838330,"ext":"jpg","by":"samaki","lic":"CC BY-NC"}],"wiki":"Ixodes pacificus","summary":"Ixodes pacificus, the Western black-legged tick, is a species of Ixodes, a parasitic tick found on the western coast of North America. It is the principal vector of Lyme Disease in that region."},
