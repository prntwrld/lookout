  {"id":182502,"slug":"rhizoplaca-chrysoleuca","sci":"Rhizoplaca chrysoleuca","common":"Orange Rock Posy","family":"Lecanoraceae","obs":286,"regions":["gorge"],"months":[1,2,3,4,5,6,7,8,9],"photos":[{"id":98455136,"ext":"jpg","by":"Jason Headley","lic":"CC BY-NC"},{"id":67452635,"ext":"jpg","by":"Jason Headley","lic":"CC BY-NC"},{"id":299959320,"ext":"jpeg","by":"Hans Ritter","lic":"CC BY-NC"},{"id":304050,"ext":"jpg","by":"anonymous","lic":"CC BY-SA"},{"id":1154172,"ext":"jpg","by":"Ed Uebel","lic":"CC BY-SA"}],"wiki":"Rhizoplaca chrysoleuca","summary":"Rhizoplaca chrysoleuca (rock-posy lichen, rockbright) is a pale yellowish-green to gray-green umbillicate foiliose lichen . It was first described in 1791 by English botanist Sir James Edward Smith as Lichen chrysoleucus; Friedrich Wilhelm Zopf transferred it to the genus Rhizoplaca in 1905."}
